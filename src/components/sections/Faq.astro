---
import JsonLd from "../JsonLd.astro";
import { faqPage } from "../../data/schema.mjs";
import { atLimitShort, earlyAccess } from "../../data/plans.mjs";
// Every answer is checked against the app's code; see README "Claims".
const faqs = [
  {
    q: "Why not just use Stripe's dashboard?",
    a: "Stripe only sees Stripe. If you also sell through the Shopify App Store or the Wix App Market, OneMRR puts it all into one MRR, shows which customers caused each change, and connects revenue to how customers use your product.",
  },
  {
    q: "Is OneMRR free?",
    a: "Yes. The Free plan is free forever with no card: two billing connections, unified MRR and ARR, exports, the API and a Churn Signals rule. Launch ($29) and Growth ($79) a month add retention automation and capacity, and are never priced on your MRR or ARR.",
  },
  {
    q: "What happens if I reach a plan limit?",
    a: atLimitShort,
  },
  {
    q: "I joined during early access. What changes?",
    a: earlyAccess,
  },
  {
    q: "How does OneMRR help with churn?",
    a: "Churn reports show who left and what it cost. Churn Signals flag paying customers whose activity drops, with the MRR at stake. Cancellation surveys tell you why people left.",
  },
  {
    q: "Will OneMRR email my customers on its own?",
    a: "Only if you turn it on, and only for the rules you choose. Every email is checked right before it goes out: the customer still pays, hasn't started cancelling, hasn't unsubscribed and wasn't emailed in the last 30 days.",
  },
  {
    q: "Does it work the same on Stripe, Shopify and Wix?",
    a: "Revenue works across all three, but the platforms share different data. Automatic cancellation follow-ups need a confirmed cancellation and the customer's email. Stripe provides both. Shopify doesn't share emails, so you add them through the API. Wix cancellations are estimated from payouts, so you share a branded survey link instead.",
  },
  {
    q: "Is my billing data safe?",
    a: "OneMRR only reads from your billing platforms. Credentials are encrypted and never shown again, and each workspace's data is kept separate in the database.",
  },
];
---
<JsonLd data={faqPage(faqs)} />
<section class="band" id="faq" aria-labelledby="faq-h">
  <div class="wrap grid">
    <div class="head">
      <h2 class="h2" id="faq-h">Questions</h2>
      <p class="lede small">Setup and API details are in the <a href="/docs">docs</a>.</p>
    </div>
    <div class="list">
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: 48px; align-items: start; }
  .list { border-top: 1px solid var(--line-2); }
  details { border-bottom: 1px solid var(--line-2); }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 20px; padding: 18px 0; font-size: 17px; font-weight: 600; letter-spacing: -0.01em; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; flex: none; font-weight: 400; font-size: 22px; line-height: 1; color: var(--ink-3); transition: transform 0.2s; }
  details[open] summary::after { transform: rotate(45deg); }
  summary:focus-visible { outline-offset: 4px; }
  .small { font-size: 16px; }
  .small a { font-weight: 600; }
  details p { padding-bottom: 20px; font-size: 15.5px; color: var(--ink-2); max-width: 64ch; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; gap: 8px; } }
</style>
