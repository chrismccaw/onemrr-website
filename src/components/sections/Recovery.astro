---
import { workspace, reasons, funnel } from "../../data/demo.mjs";
const maxR = Math.max(...reasons.map((r) => r.n));
// Survey reasons and email copy are the app's shipped defaults (revspot/src/lib/recovery/shared.ts).
const surveyReasons = ["Too expensive", "Missing features", "Not using it enough", "Switching to another product", "Other"];
const custom = ["Company name", "Logo", "Brand color", "Sender name", "Subject and body", "Survey question", "3 to 8 reasons", "Optional comment box", "Thank-you message", "Send delay", "“Powered by” on or off"];
---
<section class="band canvas" id="recovery" aria-labelledby="recovery-h">
  <div class="wrap">
    <div class="head">
      <span class="eyebrow">Cancellation feedback</span>
      <h2 class="h2" id="recovery-h">Learn why customers leave. Give them a reason to stay.</h2>
      <p class="lede">When a subscription is cancelled, OneMRR can send a short email and a one-question survey in your brand. Answers arrive grouped by reason, next to each cancellation, so you know what to fix first.</p>
    </div>

    <ol class="story" data-story>
      <li class="frame">
        <h3><span class="n">1</span>A cancellation comes in</h3>
        <div class="box app">
          <div class="ev"><span class="muted">Stripe · Oct 14, 10:42 AM</span><span>Cedar &amp; Rye cancelled <b>Pro, monthly</b></span><span class="muted">−$99 MRR at the end of the period</span></div>
          <div class="ev">
            <span class="muted">Before sending</span>
            <span class="ok">✓ Verified Stripe cancellation</span>
            <span class="ok">✓ Customer email on file</span>
            <span class="ok">✓ Hasn't unsubscribed</span>
            <span class="soft">Sending after 1 day</span>
          </div>
        </div>
      </li>
      <li class="frame">
        <h3><span class="n">2</span>Your email goes out</h3>
        <div class="box mini">
          <div class="mail-brand"><span class="mail-logo">{workspace.initial}</span>{workspace.name}</div>
          <h4>Could we ask you one quick question?</h4>
          <p>Hi Jo, thanks for giving {workspace.name} a try. We're sorry to see you go.</p>
          <p>Would you tell us what made you decide to cancel?</p>
          <span class="mail-btn">Share feedback</span>
          <p class="fine">One question. Less than a minute.</p>
        </div>
      </li>
      <li class="frame">
        <h3><span class="n">3</span>They answer in your survey</h3>
        <div class="box mini">
          <div class="mail-brand"><span class="mail-logo">{workspace.initial}</span>{workspace.name}</div>
          <h4>Sorry to see you go.</h4>
          <p>What was the main reason?</p>
          <div class="reasons">
            {surveyReasons.map((r) => <span class={r === "Missing features" ? "reason on" : "reason"}><i></i>{r}</span>)}
          </div>
        </div>
      </li>
      <li class="frame">
        <h3><span class="n">4</span>You see why</h3>
        <div class="box app">
          <div class="title sm">Cancellation feedback · last 90 days</div>
          <div class="bars">
            {reasons.map((r) => (
              <div class="rb"><span>{r.label}</span><b style={`width:${(r.n / maxR) * 100}%`}></b><span class="c">{r.n}</span></div>
            ))}
          </div>
          <ol class="funnel" aria-label="Emails">
            {funnel.map((f) => <li><b>{f.n}</b> {f.label.toLowerCase()}</li>)}
          </ol>
        </div>
      </li>
    </ol>

    <ul class="custom" aria-label="What you can customize">
      {custom.map((c) => <li>{c}</li>)}
    </ul>
    <p class="note limit">Automatic emails go to Stripe customers. Shopify and Wix don't give apps their customers' email addresses, so for marketplace cancellations OneMRR gives you a survey link to send yourself.</p>
  </div>
</section>
<script>
  // Light each frame in turn the first time the story scrolls into view.
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const root of document.querySelectorAll<HTMLElement>("[data-story]")) {
      new IntersectionObserver(([e], o) => {
        if (!e.isIntersecting) return;
        o.disconnect();
        root.classList.add("seq");
        requestAnimationFrame(() => requestAnimationFrame(() => root.classList.add("play")));
      }, { threshold: 0.3 }).observe(root);
    }
  }
</script>
<style>
  .story { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .frame { display: grid; gap: 12px; align-content: start; min-width: 0; }
  .frame h3 { display: flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
  .n { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--ink); color: #fff; font-size: 12px; font-weight: 600; flex: none; }
  .box { border-radius: 12px; padding: 14px; display: grid; gap: 10px; align-content: start; min-height: 292px; font-size: 13px; }
  .box.mini { background: #fff; border: 1px solid var(--line); color: #18181b; }
  .box.mini h4 { font-size: 16px; letter-spacing: -0.01em; line-height: 1.3; }
  .box.mini p { color: #52525b; font-size: 13px; line-height: 1.5; }
  .box.mini .mail-brand { font-size: 13.5px; }
  .box.mini .mail-logo { width: 20px; height: 20px; font-size: 10.5px; }
  .box.mini .mail-btn { font-size: 13px; padding: 8px 12px; }
  .fine { font-size: 12px !important; color: #71717a !important; }
  .ev { display: grid; gap: 4px; padding: 10px; border-radius: 9px; background: var(--d-surface); border: 1px solid var(--d-line); }
  .ok { color: var(--d-good); }
  .reasons { display: grid; gap: 6px; }
  .reason { display: flex; align-items: center; gap: 9px; padding: 7px 10px; border: 1px solid #e4e4e7; border-radius: 8px; font-size: 12.5px; color: #3f3f46; }
  .reason i { width: 13px; height: 13px; border-radius: 50%; border: 1.5px solid #a1a1aa; flex: none; }
  .reason.on { border-color: var(--brand); background: var(--brand-wash); color: #18181b; }
  .reason.on i { border: 4px solid var(--brand); }
  .title.sm { font-size: 13px; }
  .bars { display: grid; gap: 8px; }
  .rb { display: grid; grid-template-columns: 104px 1fr 18px; gap: 8px; align-items: center; font-size: 12px; color: var(--d-ink-2); }
  .rb b { display: block; height: 9px; border-radius: 2px; background: var(--d-accent); }
  .rb .c { text-align: right; color: var(--d-ink); }
  .funnel { list-style: none; padding: 10px 0 0; margin-top: 2px; border-top: 1px solid var(--d-line); display: flex; flex-wrap: wrap; gap: 6px 4px; font-size: 12px; color: var(--d-ink-3); }
  .funnel li { white-space: nowrap; }
  .funnel li:not(:last-child)::after { content: "→"; margin-left: 4px; color: var(--d-line-2); }
  .funnel b { color: var(--d-ink); font-weight: 600; }
  .custom { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; margin-top: 36px; }
  .custom li { font-size: 13.5px; padding: 5px 12px; border-radius: 999px; border: 1px solid var(--line); background: #fff; color: var(--ink-2); }
  .limit { margin-top: 18px; }

  /* Sequenced reveal, once, when the story scrolls into view (never with reduced motion). */
  .seq .frame:not(:first-child) { opacity: 0.35; transition: opacity 0.5s; }
  .seq.play .frame { opacity: 1; }
  .seq.play .frame:nth-child(2) { transition-delay: 0.7s; }
  .seq.play .frame:nth-child(3) { transition-delay: 1.4s; }
  .seq.play .frame:nth-child(4) { transition-delay: 2.1s; }

  @media (max-width: 1000px) { .story { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .story { grid-template-columns: 1fr; } .box { min-height: 0; } }
</style>
