---
import Icon from "../Icon.astro";
import { sources, mrr, usd } from "../../data/demo.mjs";

const list = [
  { mark: "S", color: "#635bff", name: "Stripe" },
  { mark: "S", color: "#437a26", name: "Shopify App Store" },
  { mark: "W", color: "#111827", name: "Wix App Market" },
  { mark: "P", color: "#8a6d00", name: "Paddle", tag: "Beta" },
  { mark: "L", color: "#b8326b", name: "Lemon Squeezy", tag: "Beta" },
  { mark: "{}", color: "#4535e6", name: "Your own billing (API)" },
];
// Small multiples share one scale, as in the app.
const max = 25000;
const spark = (h: number[]) => {
  const pts = h.map((v, i) => `${((i / (h.length - 1)) * 200).toFixed(1)},${(70 - (v / max) * 66).toFixed(1)}`);
  return { line: `M${pts.join(" L")}`, area: `M0,70 L${pts.join(" L")} L200,70Z` };
};
---
<section class="band canvas" id="platforms" aria-labelledby="platforms-h">
  <div class="wrap split">
    <div class="head">
      <h2 class="h2" id="platforms-h">Every platform. One MRR.</h2>
      <p class="lede">Stripe's dashboard only sees Stripe. OneMRR combines your Stripe, Shopify App Store and Wix App Market billing into one MRR, so the number means the same thing everywhere.</p>
      <ul class="chips" aria-label="Billing sources">
        {list.map((s) => (
          <li><span class="mark" style={`background:${s.color}`} aria-hidden="true">{s.mark}</span>{s.name}{s.tag ? <span class="tag">{s.tag}</span> : null}</li>
        ))}
      </ul>
      <ul class="points notes">
        <li><span>MRR is counted before marketplace commissions. Revenue after fees is shown separately.</span></li>
        <li><span>Wix doesn't share live subscription data, so Wix MRR is estimated from payout exports and labelled.</span></li>
        <li><span>Each platform connects differently and shares different data. <a href="/integrations">Compare platforms</a></span></li>
      </ul>
    </div>
    <figure>
      <figcaption class="sr-only">MRR by source for a demo company: {sources.map((s) => `${s.name} ${usd(s.mrr)}`).join(", ")}, {usd(mrr)} in total.</figcaption>
      <div class="app panel" aria-hidden="true">
        <div>
          <div class="title">MRR by source</div>
          <div class="muted">Each chart uses the same scale. Select a source to filter the whole dashboard.</div>
        </div>
        <div class="mults">
          {sources.map((s) => {
            const p = spark(s.history);
            const color = `var(--src-${s.key})`;
            return (
              <div class="mult">
                <span class="label"><span class={`badge sm ${s.key}`}>{s.badge}</span> {s.name} · {Math.round((s.mrr / mrr) * 100)}%{s.estimated ? " · est." : ""}</span>
                <span class="v">{usd(s.mrr)}</span>
                <span class="up small"><Icon name="arrow-up" size={12} /> {usd(s.delta, true)}</span>
                <svg viewBox="0 0 200 72" preserveAspectRatio="none">
                  <path d={p.area} fill={color} fill-opacity={s.key === "wix" ? 0.07 : 0.14} />
                  <path d={p.line} fill="none" stroke={color} stroke-width="1.8" vector-effect="non-scaling-stroke" stroke-dasharray={s.estimated ? "4 3" : undefined} />
                </svg>
              </div>
            );
          })}
        </div>
        <div class="foot muted">Before or after marketplace fees. Wix's revenue share and Shopify's fees are measured from your last 12 months.</div>
      </div>
    </figure>
  </div>
</section>
<style>
  .chips { list-style: none; padding: 0; margin-top: 8px; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px 6px 6px; border: 1px solid var(--line); border-radius: 999px; background: #fff; font-size: 14px; font-weight: 500; }
  .mark { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; color: #fff; font-size: 10.5px; font-weight: 700; }
  .tag { font-size: 11px; font-weight: 600; padding: 2px 7px; border-radius: 999px; background: var(--warn-wash); color: var(--warn); }
  .notes { margin-top: 16px; font-size: 14.5px; }
  .notes a { font-weight: 600; text-decoration: none; }
  .notes a:hover { text-decoration: underline; }
  .mults { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .mult { display: grid; gap: 4px; }
  .v { font-size: 22px; font-weight: 650; letter-spacing: -0.025em; }
  .small { font-size: 12px; }
  .mult svg { width: 100%; height: 72px; margin-top: 8px; border-bottom: 1px solid var(--d-line); }
  .foot { border-top: 1px solid var(--d-line); padding-top: 12px; }
  @media (max-width: 560px) { .mults { grid-template-columns: 1fr; } }
</style>
