---
import Base from "../layouts/Base.astro";
import Hero from "../components/sections/Hero.astro";
import Platforms from "../components/sections/Platforms.astro";
import Analytics from "../components/sections/Analytics.astro";
import Signals from "../components/sections/Signals.astro";
import Act from "../components/sections/Act.astro";
import Pricing from "../components/sections/Pricing.astro";
import Trust from "../components/sections/Trust.astro";
import Founder from "../components/sections/Founder.astro";
import Faq from "../components/sections/Faq.astro";
import Final from "../components/sections/Final.astro";
import { softwareApplication } from "../data/schema.mjs";
---
<Base
  title="OneMRR · MRR and churn analytics for Stripe, Shopify and Wix"
  description="One MRR dashboard for Stripe, Shopify and Wix. Track MRR, ARR and churn, spot customers at risk, and follow up with branded emails. Free plan, no card needed."
  schema={[softwareApplication]}
>
  <Hero />
  <Platforms />
  <Analytics />
  <Signals variant="simple" />
  <Act />
  <Pricing variant="home" />
  <Trust />
  <Founder />
  <Faq />
  <Final />
</Base>
