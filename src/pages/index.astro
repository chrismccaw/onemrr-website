---
import Base from "../layouts/Base.astro";
import Hero from "../components/sections/Hero.astro";
import Platforms from "../components/sections/Platforms.astro";
import Analytics from "../components/sections/Analytics.astro";
import Signals from "../components/sections/Signals.astro";
import Act from "../components/sections/Act.astro";
import Pricing from "../components/sections/Pricing.astro";
import Trust from "../components/sections/Trust.astro";
import Founder from "../components/sections/Founder.astro";
import Faq from "../components/sections/Faq.astro";
import Final from "../components/sections/Final.astro";
---
<Base
  title="OneMRR · Know your revenue. Keep more of it."
  description="Track MRR across Stripe, Shopify and Wix in one dashboard. Spot customers at risk, understand churn, and follow up with branded emails you control. Free during early access."
>
  <Hero />
  <Platforms />
  <Analytics />
  <Signals variant="simple" />
  <Act />
  <Pricing variant="home" />
  <Trust />
  <Founder />
  <Faq />
  <Final />
</Base>
