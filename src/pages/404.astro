---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found · OneMRR" description="This page doesn't exist." path="/404">
  <section class="band">
    <div class="wrap nf">
      <h1 class="h2">This page doesn't exist.</h1>
      <p class="lede">The link may be old, or the address may have a typo.</p>
      <a class="btn primary" href="/">Go to the homepage</a>
    </div>
  </section>
</Base>
<style>
  .nf { display: grid; gap: 16px; justify-items: start; min-height: 40vh; align-content: center; }
</style>
