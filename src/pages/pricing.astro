---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Icon from "../components/Icon.astro";
import Pricing from "../components/sections/Pricing.astro";
import { APP } from "../data/links.mjs";
import { faqPage } from "../data/schema.mjs";
import { pricing, earlyAccess, atLimitShort } from "../data/plans.mjs";
// Plans, limits, the comparison and the definitions come from src/data/plans.mjs (shared with
// the homepage and mirrored by the app). Answers here must describe what the app does today.
const faqs = [
  {
    q: "Is the Free plan really free?",
    a: "Yes, forever, with no credit card. Connect two billing sources, see unified MRR and ARR, use revenue movements, customer reporting and reconciliation, export your data, track 10,000 product events a month and run one Churn Signals rule. Your MRR figures are just as accurate as on a paid plan.",
  },
  {
    q: "Does OneMRR charge based on my MRR?",
    a: "No. Plans are priced by capacity: billing connections, tracked events, Churn Signals rules and retention emails. Your MRR, ARR and number of customers never change your price, and no plan caps how much MRR you can track. You'd only move up a plan if you need more of that capacity.",
  },
  {
    q: "What do I get by upgrading?",
    a: "Free shows you which customers are at risk and how much MRR is involved. Launch and Growth act on it: branded retention emails (automatic or approved by you), hosted cancellation feedback surveys, a two-way inbox for replies, unlimited rules, and more connections and events.",
  },
  {
    q: "What's a billing connection?",
    a: "One account on the Connections screen: a Stripe account, a Shopify app, a Wix app, a Paddle account, a Lemon Squeezy store or a custom API source. Three Shopify apps under one Partner account are three connections. Wix payout uploads belong to their Wix connection.",
    link: { href: "/integrations", t: "See what each platform supports" },
  },
  {
    q: "What counts as a tracked event?",
    a: "A product activity event your app sends for Churn Signals through the SDK, the API or a browser ping. Retries of the same event count once. If you don't use Churn Signals, you won't use any.",
    link: { href: "/docs#churn-signals", t: "How tracking works" },
  },
  {
    q: "What counts toward the retention email allowance?",
    a: "Emails sent to your customers by retention or cancellation workflows, whether automatically or after you approve a draft. Customer replies, your answers to them, digests, daily recaps, alerts and test emails don't count.",
  },
  {
    q: "What happens if I reach a limit?",
    a: atLimitShort,
    link: { href: "#limits", t: "Every detail" },
  },
  {
    q: "Can I change plans or cancel any time?",
    a: "Yes. Upgrades apply straight away. Downgrades and cancellations take effect at the end of the month you've paid for, then the workspace moves to Free with all its data and settings kept. There's no annual contract.",
  },
  {
    q: "I joined during early access. What changes?",
    a: earlyAccess,
  },
];
---
<Base title="OneMRR pricing: free MRR dashboard, Launch and Growth" description="A free MRR dashboard for Stripe, Shopify and Wix, free forever. Launch ($29) and Growth ($79) a month add retention automation. Never priced on your MRR." path="/pricing" schema={[faqPage(faqs)]}>
  <PageHead title={pricing.headline} lede={pricing.lede} />

  <Pricing variant="page" />


  <section class="band tight" aria-labelledby="pq-h">
    <div class="wrap faq">
      <div>
        <h2 class="h2 sm" id="pq-h">Pricing questions</h2>
        <p class="side">Still unsure? Email <a href="mailto:hello@onemrr.dev">hello@onemrr.dev</a>.</p>
      </div>
      <div class="list">
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}{f.link ? <> <a href={f.link.href}>{f.link.t}</a></> : null}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="band tight end">
    <div class="wrap cta">
      <h2 class="h2 sm">Start tracking your MRR for free.</h2>
      <div class="cta-actions">
        <a class="btn primary" href={APP.signup}>Get started free <Icon name="arrow-right" class="arrow" /></a>
        {pricing.paidPlansLive ? <a class="btn secondary" href={`${APP.signup}?plan=launch`}>Or choose Launch</a> : null}
      </div>
    </div>
  </section>
</Base>
<style>
  .h2.sm { font-size: clamp(26px, 3.2vw, 34px); }
  .faq { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: 48px; align-items: start; }
  .side { margin-top: 10px; font-size: 15.5px; color: var(--ink-2); }
  .side a { font-weight: 600; }
  .list { border-top: 1px solid var(--line-2); }
  details { border-bottom: 1px solid var(--line-2); }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 20px; padding: 18px 0; font-size: 17px; font-weight: 600; letter-spacing: -0.01em; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; flex: none; font-weight: 400; font-size: 22px; line-height: 1; color: var(--ink-3); transition: transform 0.2s; }
  details[open] summary::after { transform: rotate(45deg); }
  summary:focus-visible { outline-offset: 4px; }
  details p { padding-bottom: 20px; font-size: 15.5px; color: var(--ink-2); max-width: 64ch; }
  details p a { font-weight: 600; white-space: nowrap; }
  .end { border-top: 1px solid var(--line); }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; }
  @media (max-width: 900px) { .faq { grid-template-columns: 1fr; gap: 16px; } }
</style>
